table _Measures
	lineageTag: 9ff5678f-feb8-492f-9859-4ecdd3171f58

	measure 'Net Revenue' = SUM ( sales_clean[net_revenue_eur] )
		formatString: €#,0
		displayFolder: 1. Core
		lineageTag: c1862401-a32f-4c1e-9d1e-ed5d3f58b8b5

	measure Orders = COUNTROWS ( sales_clean )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: e5b41c06-214e-438c-929b-c4cacdb94e4d

	measure 'Avg Order Value' = DIVIDE ( [Net Revenue], [Orders] )
		formatString: €#,0.00
		displayFolder: 1. Core
		lineageTag: 19e322e4-39c2-47e0-87f5-f5be0862f4e2

	measure 'Refund Rate %' = DIVIDE ( CALCULATE ( [Orders], sales_clean[refunded] = "Y" ), [Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 8769ee13-6057-49e0-a6b9-d08561e57f85

	measure 'Discounted Orders %' = DIVIDE ( CALCULATE ( [Orders], sales_clean[discount_pct] > 0 ), [Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 11e12424-8b8d-4d84-a0c6-8c591d39c39d

	measure 'Avg Discount %' = AVERAGE ( sales_clean[discount_pct] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 3e05a889-8736-4c76-ba53-ef3f5365c070

	measure 'Revenue Share %' = DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALLSELECTED ( sales_clean ) ) )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: cd213dfa-916a-4d9b-8e74-24f22af3757e

	measure 'DLC Share %' = DIVIDE ( CALCULATE ( [Net Revenue], sales_clean[product_type] = "DLC" ), [Net Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: bf984ef9-221b-4cab-a2e7-22897db8d370

	measure 'DLC Revenue' = CALCULATE ( [Net Revenue], sales_clean[product_type] = "DLC" )
		formatString: €#,0
		displayFolder: 1. Core
		lineageTag: e10af82f-9f56-48a1-a466-abf73ae71df6

	measure 'Base Game Revenue' = CALCULATE ( [Net Revenue], sales_clean[product_type] = "Base game" )
		formatString: €#,0
		displayFolder: 1. Core
		lineageTag: 98b15c3b-dcca-4b06-b44e-8d17454f2e11

	measure 'PC Share %' = DIVIDE ( CALCULATE ( [Net Revenue], sales_clean[platform_family] = "PC" ), [Net Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: e943de99-7f38-4c8b-a5c1-0ca2fc23f1f5

	measure 'Console Share %' = DIVIDE ( CALCULATE ( [Net Revenue], sales_clean[platform_family] <> "PC" ), [Net Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: ce2adedd-af65-4106-bb91-dcbee85b79b3

	measure 'GOG Share of PC %' = DIVIDE ( CALCULATE ( [Net Revenue], sales_clean[store] = "GOG.com" ), CALCULATE ( [Net Revenue], sales_clean[platform_family] = "PC" ) )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 5e8b4db7-95bf-44aa-af21-2b89fd02ef05

	measure 'Europe Share %' = DIVIDE ( CALCULATE ( [Net Revenue], sales_clean[region] IN { "Western Europe", "CEE" } ), [Net Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 79dc563c-b9f0-4691-94e2-a78383ff2d9c

	measure Markets = CALCULATE ( DISTINCTCOUNT ( sales_clean[country] ), sales_clean[country] <> "Unknown" )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: f9b97c43-4634-494e-ba5d-35ceb5e48cd9

	measure Games = DISTINCTCOUNT ( sales_clean[game] )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: 90e2c399-35c6-4233-8421-acb59c743dc2

	measure 'Top Game' = MAXX ( TOPN ( 1, VALUES ( sales_clean[game] ), [Net Revenue] ), sales_clean[game] )
		displayFolder: 4. Labels
		lineageTag: f9f276df-73ff-4ffa-962c-a8832e74f3e3

	measure 'Top Market' = MAXX ( TOPN ( 1, VALUES ( sales_clean[country] ), [Net Revenue] ), sales_clean[country] )
		displayFolder: 4. Labels
		lineageTag: a2d50f26-67dc-4c34-9dcb-18b8ad34df8d

	measure 'Top Platform' = MAXX ( TOPN ( 1, VALUES ( sales_clean[platform] ), [Net Revenue] ), sales_clean[platform] )
		displayFolder: 4. Labels
		lineageTag: add518ed-9e81-4c03-a445-faf42d5cea64

	measure 'Top Region' = MAXX ( TOPN ( 1, VALUES ( sales_clean[region] ), [Net Revenue] ), sales_clean[region] )
		displayFolder: 4. Labels
		lineageTag: f0f47aa9-3964-48a9-8f2f-5fba816ac937

	measure Target = IF ( ISFILTERED ( sales_clean[game] ) || ISFILTERED ( sales_clean[franchise] ) || ISFILTERED ( sales_clean[platform] ) || ISFILTERED ( sales_clean[country] ) || ISFILTERED ( sales_clean[region] ) || ISFILTERED ( sales_clean[product_type] ) || ISFILTERED ( sales_clean[platform_family] ) || ISFILTERED ( sales_clean[store] ) || ISFILTERED ( sales_clean[discount_band] ) || ISFILTERED ( sales_clean[refunded] ), BLANK (), SUM ( targets[target_eur] ) )
		formatString: €#,0
		displayFolder: 2. Target
		lineageTag: 528070e7-380f-43b3-a257-6219c0ae1a54

	measure 'Achievement %' = DIVIDE ( [Net Revenue], [Target] )
		formatString: 0.0%
		displayFolder: 2. Target
		lineageTag: 4aab88b3-c755-4cb6-a784-5920e2844c3d

	measure 'Variance vs Target' = IF ( NOT ISBLANK ( [Target] ), [Net Revenue] - [Target] )
		formatString: €#,0;-€#,0
		displayFolder: 2. Target
		lineageTag: 76960d30-71ac-4d6d-8b28-b151742d44f7

	measure 'Net Revenue YTD' = TOTALYTD ( [Net Revenue], 'Calendar'[Date] )
		formatString: €#,0
		displayFolder: 3. Time
		lineageTag: 19aabc23-4361-483c-b233-9f9280c1e01e

	measure 'Target YTD' = TOTALYTD ( [Target], 'Calendar'[Date] )
		formatString: €#,0
		displayFolder: 3. Time
		lineageTag: 266a0d0e-9c42-469b-accd-969985dfdc61

	measure 'Achievement Color' = SWITCH ( TRUE (), ISBLANK ( [Achievement %] ), "#6B6B70", [Achievement %] >= 1, "#1E8E5A", [Achievement %] >= 0.95, "#B57600", "#D7141A" )
		displayFolder: 5. Formatting
		lineageTag: fabbe773-cd33-4169-82a9-a7b3e93be193

	measure 'Achievement Label' = IF ( ISBLANK ( [Target] ), "target n/a", "target " & FORMAT ( [Target], "€#,0" ) )
		displayFolder: 4. Labels
		lineageTag: b605acce-7e4f-4c6e-9219-8a09bb89c8eb

	measure 'Net Revenue PY' = CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		displayFolder: 3. Time
		lineageTag: 1ac09fb7-f6e0-4ea5-82ac-f73928004c89

	measure 'Net Revenue vs PY' =
			VAR _c = [Net Revenue]
			VAR _p = [Net Revenue PY]
			RETURN
				IF ( NOT HASONEVALUE ( 'Calendar'[Year] ), "2023–2025 total",
					IF ( ISBLANK ( _p ), "no prior year", "vs PY  " & IF ( _c >= _p, "▲ ", "▼ " ) & FORMAT ( DIVIDE ( _c - _p, _p ), "+0.0%;-0.0%" ) ) )
		displayFolder: 4. Labels
		lineageTag: b4949f4c-f0d9-4d7a-a1da-e8811fa85475

	measure 'Net Revenue vs PY Color' =
			VAR _c = [Net Revenue]
			VAR _p = [Net Revenue PY]
			RETURN
				IF ( NOT HASONEVALUE ( 'Calendar'[Year] ) || ISBLANK ( _p ), "#6B6B70", IF ( _c >= _p, "#1E8E5A", "#D7141A" ) )
		displayFolder: 5. Formatting
		lineageTag: c87b2238-3a33-47e7-92c3-f1931436316e

