				IF ( NOT HASONEVALUE ( 'Calendar'[Year] ), "2023–2025 total",
					IF ( ISBLANK ( _p ), "no prior year", "vs PY  " & IF ( _c >= _p, "▲ ", "▼ " ) & FORMAT ( _c - _p, "+0;-0" ) ) )
		displayFolder: 4. Labels
		lineageTag: 2ea79700-ef9e-425c-bfc0-45802bbc5c16

	measure 'Markets vs PY Color' =
			VAR _c = [Markets]
			VAR _p = [Markets PY]
			RETURN
				IF ( NOT HASONEVALUE ( 'Calendar'[Year] ) || ISBLANK ( _p ), "#6B6B70", IF ( _c >= _p, "#1E8E5A", "#D7141A" ) )
		displayFolder: 5. Formatting
		lineageTag: 194523e8-8257-45da-9a7e-7eac1adfef2a

	measure 'Data As Of' = "Data as of " & FORMAT ( CALCULATE ( MAX ( sales_clean[order_date] ), ALL ( sales_clean ) ), "dd MMM yyyy" )
		displayFolder: 4. Labels
		lineageTag: ce3f1ec5-1d4c-4965-9c43-01fb860d5cb5

	measure Disclaimer = "All figures are fictitious and generated for portfolio purposes. Not affiliated with or endorsed by CD PROJEKT S.A."
		displayFolder: 4. Labels
		lineageTag: 7f710a54-1b80-436e-a805-34509ebcfbc2

	column Dummy
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c2395f2d-3fa2-405d-95c7-278bb758c110
		summarizeBy: none
		sourceColumn: [Dummy]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW ( "Dummy", 0 )

